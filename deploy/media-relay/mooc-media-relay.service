[Unit]
Description=MOOC temporary media relay
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=mooc-media-relay
StateDirectoryMode=0700
EnvironmentFile=/etc/mooc-media-relay.env
ExecStart=/usr/bin/python3 /opt/mooc-media-relay/relay.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
