# 云服务（仅服务端持有模型凭据；不要放入 VITE_* 变量）
HOST=127.0.0.1
PORT=8787
CLOUD_DATA_DIR=.data/cloud
# 生产环境必须使用 PostgreSQL 和 HTTPS 反向代理
DATABASE_URL=
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_SECRET=
# 使用 Dreamactor 时可设公网 HTTPS 反向代理地址，供云端读取签名 /files 链接。
# 本地试用的另一选择是配置下方私有对象存储。客户端仍连接本机 8787。
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 自有服务器中转 Dreamactor 参考图和动作模板。填写中转服务 HTTPS 根地址及上传/签名令牌。
MEDIA_RELAY_URL=
MEDIA_RELAY_TOKEN=
# 实际采购单价/产品定价在服务端目录配置，不将文档价格视为承诺
DASHSCOPE_API_KEY=
SFM_WORKSPACE_ID=
VOLC_MEDIAKIT_API_KEY=
# Dreamactor / OmniHuman 国内火山直连；凭据仅放服务端
VISUAL_PROVIDER=volcengine
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_SESSION_TOKEN=
# 内置动作预设的 6 秒视频地址；从讲师档案截取动作时可留空。
MOTION_TEMPLATE_EXPLAIN_URL=
MOTION_TEMPLATE_EMPHASIZE_URL=
MOTION_TEMPLATE_NOD_URL=
MOTION_TEMPLATE_GREET_URL=
MOTION_TEMPLATE_CLOSE_URL=
# 可选机构网关：仅 VISUAL_PROVIDER=gateway 时启用
VISUAL_GATEWAY_URL=
VISUAL_GATEWAY_TOKEN=
VISUAL_OUTPUT_HOSTS=
ENABLED_VERIFIED_MODELS=
S3_ENDPOINT=
S3_REGION=cn-beijing
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 桌面环境可用路径或设置页面指定
FFMPEG_PATH=
FFPROBE_PATH=
SOFFICE_PATH=
